{
  "layer": "top",
  "position": "top",
  "height": 10,
  "spacing": 5,

  "modules-left": [
    "sway/workspaces", "sway/mode",
  ],
  "modules-center": [

  ],
  "modules-right": [
    "custom/night_light",
    "idle_inhibitor",
    "pulseaudio",

    "network",
    "cpu",
    "memory",
    "disk",
    "temperature",

    "custom/clock",
    "battery",
    "tray",
    "custom/wf-recorder-status"
  ],
  "custom/night_light": {
      "format": "{}",
      "exec": "~/.config/waybar/scripts/toggle_night_light.sh status",
      "on-click": "~/.config/waybar/scripts/toggle_night_light.sh toggle",
      "interval": 60,
      "signal": 9,
      "tooltip-format": "Night Light: {alt}",
      "class": "night-light"
  },
  "idle_inhibitor": {
    "start-activated": true,
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },

  "pulseaudio": {
    "format": " {icon}  {volume}%  {format_source} ",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": "",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "nmtui"
  },

  "cpu": {
    "format": " {usage:02}%",
    "tooltip": false,
    "interval": 3
  },

  "memory": {
    "format": " {used:0.1f}GB",
    "tooltip-format": "{used:0.1f}GB / {total:0.1f}GB"
  },

  "disk": {
    "path": "/",
    "interval": 60,
    "unit": "GiB",
    "format": "\uf0a0 {specific_used:0.0f}GB",
    "tooltip-format": "{specific_used:0.0f}GB / {specific_total:0.0f}GB used ({percentage_used}%), {specific_free:0.0f}GB free",
    "states": { "warning": 85, "critical": 95 },
    "on-click": "alacritty -e sh -c 'command -v ncdu >/dev/null && ncdu ~ || { du -xsh ~/* ~/.[!.]* 2>/dev/null | sort -rh | head -25; read x; }'"
  },

  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
    "tooltip": false
  },

  "custom/clock": {
    "exec": "~/.config/waybar/scripts/clock.sh",
    "return-type": "json",
    "interval": 30,
    "on-click": "~/.config/waybar/scripts/kcal/kcal.py --toggle"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 5
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": "󱐌 {capacity}%",
    "format-alt": "{time} {icon}",
    "format-full": "󰠠 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip": true,
    "tooltip-format": "{timeTo}\n{power} W\nHealth: {health}%\nCycles: {cycles}",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/battery-info.sh"
  },
  "custom/wf-recorder-status": {
    "exec": "~/.config/waybar/scripts/wf-recorder-status.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 8,
    "on-click": "~/.config/sway/scripts/record.sh"
  }
}
