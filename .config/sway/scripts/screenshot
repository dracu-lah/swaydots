#!/bin/sh
# Screenshot to ~/Pictures/Screenshots and the clipboard.
# Usage: screenshot [-f full screen (default) | -s select region]

dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"

case "$1" in
    -s)
        region=$(slurp -b e3eaf699) || exit 0
        file="$dir/$(date +%Y%m%d_%H-%M-%S)_Selected.png"
        grim -g "$region" "$file" || exit 1
        label="Selection"
        ;;
    -h)
        echo "Usage: screenshot [-f] [-s]"
        exit 0
        ;;
    *)
        file="$dir/$(date +%Y%m%d_%H-%M-%S)_Fullscreen.png"
        grim "$file" || exit 1
        label="Full screen"
        ;;
esac

wl-copy --type image/png < "$file"
notify-send -i "$file" "Screenshot taken" "$label, copied to clipboard"
